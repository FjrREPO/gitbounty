# GitBounty API — copy to .env (or export) and adjust
PORT=8080
DATABASE_PATH=gitbounty.db

# Goldsky subgraph endpoint (preferred source; avoids RPC rate limits)
SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cm769b6m60y0a01sz7ze9ce2j/subgraphs/gitbounty-coston2/1.0.0/gn

# RPC fallback, used only when SUBGRAPH_URL is empty
RPC_URL=https://coston2-api.flare.network/ext/C/rpc
ESCROW_ADDRESS=0xa8adefe2c8f0f71a585a73c1259997f593f9e463

SYNC_INTERVAL=30s

# Server-side GitHub enrichment (5000 req/h). Create at github.com/settings/tokens
GITHUB_TOKEN=
