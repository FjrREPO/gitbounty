{
  "name": "gitbounty",
  "version": "0.1.0",
  "private": true,
  "description": "Trustless GitHub bounties on Flare with confidential verification",
  "license": "MIT",
  "author": "FjrREPO",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
